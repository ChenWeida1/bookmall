# 多阶段构建单个 Spring Boot 模块镜像。
# 构建参数 MODULE：如 bookmall-user、bookmall-catalog。
# 构建上下文必须是仓库根目录（含父 POM 与各模块）。
FROM maven:3.9.9-eclipse-temurin-21 AS build
ARG MODULE
WORKDIR /src
COPY pom.xml .
COPY bookmall-common bookmall-common
COPY bookmall-gateway bookmall-gateway
COPY bookmall-user bookmall-user
COPY bookmall-catalog bookmall-catalog
COPY bookmall-order bookmall-order
COPY bookmall-notification bookmall-notification
COPY bookmall-assistant bookmall-assistant
RUN mvn -pl ${MODULE} -am -DskipTests package

FROM eclipse-temurin:21-jre
ARG MODULE
WORKDIR /app
COPY --from=build /src/${MODULE}/target/${MODULE}-1.0.0.jar app.jar
EXPOSE 8080 8081 8082 8083 8084 8085
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
